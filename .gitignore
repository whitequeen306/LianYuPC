# LianYu-PC .gitignore（.env、密钥、构建产物不入库）
# =====================

# Environment
.env
secrets/platform-keys.txt
backend/scripts/_vault_reseed.sql
backend/scripts/out/

# Local one-shot ship scripts / notes (never commit; see AGENTS.md → 发布发版)
local/

# QQ 云端托管网关（channel-gateway）：依赖与本地账号数据不入库
channel-gateway/node_modules/
channel-gateway/.data/

# 本地向量模型权重（onnx，约 24MB）。用 backend-agent/scripts/fetch_embedding_model.py 拉取，
# compose 以只读方式挂到 /app/models；二进制不进仓库
models/

# Java / Maven
backend/target/
backend/*/target/
*.class
*.jar
*.war

# IDE / editor
.idea/
*.iml
.vscode/
.cursor/
*.tmp
.tmp_*
.tmp/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Pet voice enrollment samples (keep clip + registry only)
backend/lianyu-service/src/main/resources/pet-voice-samples/*.wav
!backend/lianyu-service/src/main/resources/pet-voice-samples/*-clip.wav

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-electron/
frontend/release/

# Docker
docker-compose.override.yml
certs/*.crt
certs/*.key


# Local tooling / chat history (may contain secrets)
.specstory/
.codegraph/
.cortexloop/
.superpowers/
.worktrees/
config.json
avatar/

# CodeCortexLoop generated reports (keep out of git)
docs/cortexloop/

# Deployment artifacts (large binaries)
.deploy-export/

# Installer red-team unpack output (regenerated by scripts/_audit_installer_unpack.py)
release_audit/

# Build artifacts (regenerated; not source)
frontend/main-bundle.cjs

# Local debug dumps
.issue_dump.json
.issue_dump.md
debug-*.png
frontend/build-agent-log.txt

# Release builds (regenerated by electron-builder)
frontend/release/
frontend/release-*/
# Branded installer build output and embedded payload
installer/**/bin/
installer/**/obj/
installer/**/Payload/
# Installer skin artifacts (regenerated, large binaries)
frontend/build/skin/
frontend/build/nsNiuniuSkin.dll
frontend/build/x86-unicode/
frontend/build/*.bmp
# 例外：NSIS MUI 的品牌位图是**打包输入**，必须进仓库。
# 否则换台机器构建时 electron-builder 会静默回退到 nsis3-metro.bmp，
# 品牌标识凭空消失且没有任何报错。
!frontend/build/installerSidebar.bmp
!frontend/build/installerHeader.bmp
frontend/build/logo.ico
frontend/build/skin.zip
# Generated scripts (one-off, not source)
frontend/scripts/gen-*.mjs
frontend/scripts/gen-*.cjs

# Python cache
**/__pycache__/
*.pyc

# One-off cloud incident diag/fix scripts and local run artifacts (see scripts/diag/README.md, artifacts/README.md)
scripts/diag/
artifacts/
scripts/test_updater_flow.py
.zcode/
pytest-of-*/
backend-agent/pytest-of-hp/
ship-*.log
frontend/.tmp-*/
.tmp-*/
