# 云端桌面构建：npm run electron:release 时 electron-pack.mjs 自动加载
# 迁机后优先改 DNS；证书指纹需与服务器 TLS 证书一致（SPKI 未变时可仅更新 fingerprint）
VITE_LIANYU_API_ORIGIN=https://downloadlianyu.asia
VITE_LIANYU_UPDATE_ORIGIN=https://downloadlianyu.asia:4443
VITE_LIANYU_CERT_FINGERPRINT=02:04:E3:05:31:A1:6E:B6:57:C9:65:B7:D3:BF:0B:5F:F5:BA:D3:07:0E:AB:FB:98:B5:D5:14:6A:03:C4:C9:B1

# latest.yml 的 Ed25519 验签公钥（SPKI DER base64，公开值）。
# 留空 = 客户端暂不强制验签（只打一次告警）。上线顺序必须是：
#   1) 部署 nginx 的 latest.yml.sig 路由  2) 发布带 .sig 的清单
#   3) 最后取消注释填入公钥并重打客户端 —— 顺序颠倒会让旧清单直接验签失败。
# 取值：python scripts/sign_update_manifest.py --print-public-key
# VITE_LIANYU_UPDATE_PUBKEY=
