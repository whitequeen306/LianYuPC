<Application x:Class="LianYu.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 不用 StartupUri：App.OnStartup 按命令行开关决定开窗还是走无界面安装（见 App.xaml.cs） -->
  <Application.Resources>
    <Color x:Key="AccentColor">#FFF4A6B5</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8EDF2" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8995A2" />
  </Application.Resources>
</Application>
