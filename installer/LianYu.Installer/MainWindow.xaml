<Window x:Class="LianYu.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="860" Height="560" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F2141A24" Offset="0"/><GradientStop Color="#F20B1018" Offset="1"/></LinearGradientBrush>
    <Style TargetType="Button" x:Key="PrimaryButton"><Setter Property="Foreground" Value="#FF25171D"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="26,13"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="26" Background="#FFF4A6B5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button" x:Key="GhostButton"><Setter Property="Foreground" Value="#FFF2BAC8"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#12F4A6B5"/><Setter Property="BorderBrush" Value="#35F4A6B5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="GhostBorder" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GhostBorder" Property="Background" Value="#28F4A6B5"/><Setter TargetName="GhostBorder" Property="BorderBrush" Value="#78F4A6B5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="GhostBorder" Property="Background" Value="#40D48494"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="RadioButton" x:Key="ScopeRadio"><Setter Property="Foreground" Value="#FFBFC9D3"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Pill" CornerRadius="15" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="10,6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="#DDF4A6B5"/><Setter TargetName="Pill" Property="BorderBrush" Value="#FFF4A6B5"/><Setter Property="Foreground" Value="#FF2A1720"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button" x:Key="WindowButton"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="#08FFFFFF"/><Setter Property="Foreground" Value="#FFB5C0CB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="16" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox" x:Key="GlassCheckBox"><Setter Property="Foreground" Value="#FFD4DCE4"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="17" Height="17" CornerRadius="6" BorderBrush="#48F4A6B5" BorderThickness="1" Background="#1AFFFFFF" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" Foreground="#FF2A1720" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#FFF4A6B5"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFF4A6B5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox" x:Key="PathBox"><Setter Property="Foreground" Value="#FFDDE4EB"/><Setter Property="Background" Value="#1CFFFFFF"/><Setter Property="BorderBrush" Value="#2CFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="11"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border x:Name="RootBorder" CornerRadius="30" Background="{StaticResource WindowBrush}" BorderBrush="#40F4A6B5" BorderThickness="1" ClipToBounds="True" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#12FFFFFF" CornerRadius="30,30,0,0" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid><StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center"><Image Source="Assets/logo.png" Width="30" Height="30" Stretch="Uniform"/><StackPanel Margin="11,0,0,0"><TextBlock Text="恋语" Foreground="#FFE8EDF2" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="L I A N Y U" Foreground="#FF8D99A6" FontSize="9"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,0"><Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/><Button Content="×" Style="{StaticResource WindowButton}" Click="Close_Click"/></StackPanel></Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.Background><RadialGradientBrush Center="0.12,0.7" RadiusX="0.95" RadiusY="1"><GradientStop Color="#45F4A6B5" Offset="0"/><GradientStop Color="#10151D" Offset="0.55"/><GradientStop Color="#080C12" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="48*"/><ColumnDefinition Width="52*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="22,20,10,24">
          <Border Width="310" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="28" Background="#18FFFFFF" BorderBrush="#2DFFFFFF" BorderThickness="1" RenderTransformOrigin=".5,.5"><Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform><Image x:Name="ImageBack" Source="Assets/mika.jpg" Stretch="UniformToFill" Opacity=".24"/></Border>
          <Border Width="310" Height="365" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="28" Background="#25FFFFFF" BorderBrush="#55F4A6B5" BorderThickness="1" Padding="2"><Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity=".35" Color="#000000"/></Border.Effect><Image x:Name="ImageFront" Source="Assets/mahiru.jpg" Stretch="UniformToFill"/></Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15,0,0,5" Padding="11,7" CornerRadius="18" Background="#B2131A24" BorderBrush="#28FFFFFF" BorderThickness="1"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#FFF4A6B5" Margin="0,0,7,0"/><TextBlock Text="角色陪伴 · 已准备就绪" Foreground="#FFD6DDE4" FontSize="11"/></StackPanel></Border>
        </Grid>
        <Border Grid.Column="1" Margin="12,26,28,26" Padding="28,30,28,18" CornerRadius="30" Background="#A9141A24" BorderBrush="#38FFFFFF" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity=".3" Color="#000000"/></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel x:Name="BrandingPanel" RenderTransformOrigin="0.5,0"><StackPanel.RenderTransform><TranslateTransform Y="0"/></StackPanel.RenderTransform><TextBlock Text="L I A N Y U  ·  P I N K  R O M A N C E" Foreground="#FFF4A6B5" FontSize="10"/><TextBlock x:Name="HeroTitle" Text="把陪伴，&#x0a;留在你的桌面。" Foreground="#FFF3F5F7" FontFamily="Georgia" FontSize="30" FontWeight="SemiBold" LineHeight="40" Margin="0,16,0,12"/><TextBlock x:Name="HeroDescription" Text="角色会记得你的习惯、情绪和那些小小的日常。&#x0a;从现在开始，每一次打开都有回应。" Foreground="#FFA8B3BF" FontSize="13" LineHeight="22" MaxHeight="60" ClipToBounds="True"/><Border x:Name="PackageInfo" Margin="0,20,0,0" Padding="12" MaxHeight="70" ClipToBounds="True" CornerRadius="16" Background="#18F4A6B5" BorderBrush="#25F4A6B5" BorderThickness="1"><StackPanel><TextBlock Text="离线完整安装包" Foreground="#FFF0C5CF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="约 166 MB · Windows 10 / 11 · 无需网络" Foreground="#FF8995A2" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></StackPanel><StackPanel Grid.Row="1"><Button x:Name="InstallButton" Content="立即安装" Height="50" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Click="Install_Click"/><Button x:Name="CustomButton" Content="自定义安装" Height="38" Style="{StaticResource GhostButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="ToggleSettings_Click"/><Border x:Name="SettingsPanel" Visibility="Visible" Height="0" Opacity="0" ClipToBounds="True" HorizontalAlignment="Left" Width="300" Margin="0,8,0,0" Padding="10" CornerRadius="18" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"><StackPanel><TextBlock Text="安装选项" Foreground="#FFE8EDF2" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox x:Name="InstallDirectoryBox" Style="{StaticResource PathBox}"/><Button Grid.Column="1" Content="📁" ToolTip="选择安装文件夹" Width="38" Height="34" Padding="0" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Click="BrowseDirectory_Click"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,6"><TextBlock Text="安装范围" Foreground="#FF8995A2" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/><RadioButton x:Name="CurrentUserRadio" Content="当前用户" GroupName="Scope" IsChecked="True" Style="{StaticResource ScopeRadio}"/><RadioButton x:Name="AllUsersRadio" Content="所有用户" GroupName="Scope" Style="{StaticResource ScopeRadio}"/></StackPanel><WrapPanel Grid.Row="2"><CheckBox x:Name="DesktopBox" Style="{StaticResource GlassCheckBox}" Content="桌面快捷方式" IsChecked="True"/><CheckBox x:Name="StartMenuBox" Style="{StaticResource GlassCheckBox}" Content="开始菜单" IsChecked="True"/><CheckBox x:Name="AutoStartBox" Style="{StaticResource GlassCheckBox}" Content="开机启动"/><CheckBox x:Name="LaunchBox" Style="{StaticResource GlassCheckBox}" Content="安装后运行" IsChecked="True"/></WrapPanel></Grid></StackPanel></Border><TextBlock x:Name="StatusText" Text="安装完成后自动启动恋语" Foreground="#FF728090" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Grid></Border>
      </Grid>
    </Grid>
  </Border>
</Window>
