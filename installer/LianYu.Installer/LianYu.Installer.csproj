<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YuNian-Setup</AssemblyName>
    <RootNamespace>LianYu.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version Condition="'$(LianYuVersion)' == ''">0.2.363</Version>
    <Version Condition="'$(LianYuVersion)' != ''">$(LianYuVersion)</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      压缩版（282MB）与不压缩版（353MB）都实测能用，保留压缩以减小下载体积。
      排查记录（2026-10-21）：有人反馈「双击后 SmartScreen 点仍要运行却什么都不发生」，
      抓到的错误是
        Failed to create directory [...\Temp\.net\YuNian-Setup-x.y.z\] ... Error code: 5
      看着像压缩解包的锅，实际**不是**：同一个压缩版拷到 %TEMP% 下运行完全正常。

      同日第二次复现（更完整）：进程存活 184s / WS 432MB / CPU 22s，但**没有任何顶层
      窗口**且 `PresentationFramework` 未加载 —— 根本没进 WPF。A/B 对照证明同一份字节
      （SHA256 一致）在 %TEMP% 里 2.8s 装完、在仓库目录里 `Start-Process` 直接抛
      「The operation was canceled by the user」卡 405s。根因是 Windows 对**未签名**
      安装包的「未知发布者」拦截，警告不点掉进程就不会被创建。
      → 根治只能给 exe 签名；换打包方式（NSIS/msi）同样被拦。详见
        docs/refactor-2026-10/client-release.md 第七节。
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\mahiru.jpg" />
    <Resource Include="Assets\mika.jpg" />
    <Resource Include="Assets\character-a.jpg" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!--
    内嵌的是 electron-builder 打好的 NSIS 安装器（约 166MB），不是原始负载 zip。
    界面由 WPF 出，安装/卸载/注册表/快捷方式全部交给 NSIS —— 这样才有卸载器，
    体积也从 282MB 降到约 170MB。详见 InstallerEngine.cs 文件头。
    LogicalName 必须与 InstallerEngine.PayloadResource 一致。
  -->
  <ItemGroup Condition="Exists('Payload\YuNian-Engine.exe')">
    <EmbeddedResource Include="Payload\YuNian-Engine.exe" LogicalName="LianYu.Engine.exe" />
  </ItemGroup>
</Project>
